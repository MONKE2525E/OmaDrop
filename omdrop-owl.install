post_install() {
  # NetworkManager reads conf.d only at startup or on a reload, so keeping
  # awdl0 and mon0 unmanaged isn't in force until something rereads it.
  # `reload conf` touches no connection.
  if systemctl is-active --quiet NetworkManager 2>/dev/null; then
    nmcli general reload conf >/dev/null 2>&1 \
      || echo "  Could not reload NetworkManager's configuration. Run: sudo nmcli general reload conf"
  fi
  cat <<'MSG'
  Installed OmaDrop's AirDrop radio helper. Open OmaDrop from the Omarchy bar
  to start nearby sharing. Panel setup and troubleshooting:

      https://github.com/MONKE2525E/OmaDrop#readme

  In shared mode, your Wi-Fi access point has to be on channel 6, 44 or 149:
  AirDrop shares its channel. `/usr/lib/omdrop/omdrop-discoverable probe` says what, if
  anything, is in the way.
MSG
}

post_upgrade() {
  post_install
}

# The PreTransaction hook restores the radio before removal and aborts the
# transaction on failure. A pre_remove scriptlet cannot abort pacman removal.
