+# Put a file on the clipboard, only when the user asks (`omdrop act copy FILE`):
+# a link as its URL, an image as the image itself, anything else as its path.
+# Arrivals never do this on their own, since it would replace whatever the user
+# had copied. wl-copy forks a server to own the selection, so it has to survive
+# us -- launch() gives it its own unit, the same reason the viewer needed one.
 copy_to_clipboard() {
   local f=$1 url; url=$(link_target "$f")
   command -v wl-copy >/dev/null 2>&1 || return 0
